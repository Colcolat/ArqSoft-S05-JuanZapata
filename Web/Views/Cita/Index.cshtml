@model List<CitasApp.Models.Cita>
@{
    var pacientes = ViewBag.Pacientes as List<Paciente>;
    var medicos = ViewBag.Medicos as List<Medico>;

}


<h1>Agenda de citas</h1>
<table border="2" cellpadding="9">
    <tr>
        <th>Fecha</th>
        <th>Hora</th>
        <th>Paciente</th>
        <th>Médico</th>
        <th>Motivo</th>
        <th>Estado</th>
    </tr>

    @foreach (var cita in Model)
    {
        var paciente = ((IEnumerable<Paciente>)ViewBag.Pacientes).FirstOrDefault(p => p.Id == cita.PacienteId);
        var medico = ((IEnumerable<Medico>)ViewBag.Medicos).FirstOrDefault(m => m.Id == cita.MedicoId);

        <tr>
            <td>@cita.Fecha.ToString("dd/MM/yyyy")</td>
            <td>@cita.Hora.ToString("HH:mm")</td> <td>@(paciente != null ? $"{paciente.Nombre} {paciente.Apellido}" : "Desconocido")</td>
            <td>@(medico != null ? $"Dr. {medico.Nombre} {medico.Apellido}" : "Desconocido")</td>
            <td>@cita.Motivo</td>
            <td>@cita.Estado</td>
        </tr>
    }
</table>


<br />