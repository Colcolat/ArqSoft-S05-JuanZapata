@model List<CitasApp.Application.DTOs.CitaViewModel>

@{
    ViewData["Title"] = "Citas";
    Layout = "_Layout";
}

<div class="page-header page-header--purple">
    <div class="page-header-inner">
        <div>
            <h2>Citas</h2>
            <p class="page-header-sub">@Model.Count cita(s) registrada(s)</p>
        </div>
        @if (User.IsInRole("Admin") || User.IsInRole("Paciente"))
        {
            <a asp-action="Nuevo" class="btn btn-light-outline">+ Agregar Nueva</a>
        }
    </div>
</div>

<div class="table-wrapper">
    <table class="table">
        <thead>
            <tr>
                <th>Paciente</th>
                <th>Médico</th>
                <th>Fecha</th>
                <th>Hora</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cita in Model)
            {
                <tr>
                    <td data-label="Paciente">
                        <div class="table-name-cell">
                            <div class="avatar avatar-sm">@cita.NombrePaciente[0]</div>
                            <span>@cita.NombrePaciente</span>
                        </div>
                    </td>
                    <td data-label="Médico">@cita.NombreMedico</td>
                    <td data-label="Fecha">@cita.Fecha</td>
                    <td data-label="Hora">@cita.FechaHora</td>
                    <td data-label="Estado">
                        @if (cita.Estado == "Confirmada")
                        {
                            <span class="badge bg-success">Confirmada</span>
                        }
                        else
                        {
                            <span class="badge bg-warning">Pendiente</span>
                        }
                    </td>
                    <td class="d-flex gap-1 flex-wrap">
                        <a asp-action="Detalle" asp-route-id="@cita.Id" class="btn btn-info btn-sm">Ver</a>
                        @if ((User.IsInRole("Medico") || User.IsInRole("Admin")) && cita.Estado == "Pendiente")
                        {
                            <form asp-action="CambiarEstado" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@cita.Id"/>
                                <input type="hidden" name="estado" value="Confirmada"/>
                                <button type="submit" class="btn btn-success btn-sm">Confirmar</button>
                            </form>
                        }
                        @if ((User.IsInRole("Medico") || User.IsInRole("Admin")) && cita.Estado == "Confirmada")
                        {
                            <form asp-action="CambiarEstado" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@cita.Id"/>
                                <input type="hidden" name="estado" value="Pendiente"/>
                                <button type="submit" class="btn btn-warning btn-sm">Marcar Pendiente</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
