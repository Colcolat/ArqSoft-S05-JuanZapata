@model CitasApp.Models.CitaViewModel

@{
    ViewData["Title"] = "Detalle de Cita";
}

<h2>Detalle de Cita</h2>

<dl class="row">
    <dt class="col-sm-3">Paciente</dt>
    <dd class="col-sm-9">@Model.NombrePaciente</dd>

    <dt class="col-sm-3">Médico</dt>
    <dd class="col-sm-9">@Model.NombreMedico</dd>

    <dt class="col-sm-3">Fecha</dt>
    <dd class="col-sm-9">@Model.Fecha</dd>

    <dt class="col-sm-3">Hora</dt>
    <dd class="col-sm-9">@Model.FechaHora</dd>

    <dt class="col-sm-3">Motivo</dt>
    <dd class="col-sm-9">@Model.Motivo</dd>

    <dt class="col-sm-3">Estado</dt>
    <dd class="col-sm-9">@Model.Estado</dd>
</dl>

<a asp-action="Cita" class="btn btn-secondary">Volver</a>