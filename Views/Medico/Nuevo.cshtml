@model CitasApp.Models.Medico;

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <title>Agregar Nuevo Paciente</title>
</head>
<body>
<div>
    <form asp-action="Nuevo" method="post">
        <div class="mb-3">
            <label>Nombre</label>
            <input asp-for="Nombre" class="form-control" />
        </div>
        <div class="mb-3">
            <label>Apellido</label>
            <input asp-for="Especialidad" class="form-control" />
        </div>
        <div class="mb-3">
            <label>Numero de Licencia</label>
            <input asp-for="NumeroLicencia" class="form-control" />
        </div>
        <button type="submit" class="btn btn-primary">Guardar</button>
        <a asp-action="Medico" class="btn btn-secondary">Cancelar</a>
    </form>
</div>
</body>
</html>