@model List<CitasApp.Models.Paciente>

@{
    ViewBag.Title = "Citas App";
    Layout = "_Layout";
}

<h2>Pacientes</h2>
<table class="listaPacientes">
    
    @foreach (var paciente in Model)
    {
        <ul>
            <li>
            <a asp-action="Detalle" asp-route-id="@paciente.Id">
                @paciente.Nombre @paciente.Apellido
            </a>
            </li>
        </ul>
    }
   
</table>
<a asp-controller="Paciente" asp-action="Nuevo" class="btn btn-primary">Agregar Nuevo</a>

